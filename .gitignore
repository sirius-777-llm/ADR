.env
.env.*
!.env.example
*.pyc
__pycache__/
*.bak
*.bak.*
*.log
/output/
/tmp/
# 音色库：只追踪 voice_assets.json 元数据 (catalog + sha256)
# 不追踪 references/ 下面的 wav (体积大 + 涉及第三方音频版权风险)
voice_assets/references/
voice_assets/*.wav
voice_assets/*.mp3
# 密钥/token 类安全兜底（任何包含这些字符串的文件都不提交）
*secret*
*_token*
*.key
*.pem
credentials.json
# 历史实验脚本（硬编码风险）
img2img_*.py
gen_covers*.py
tts_gen*.py
_patch_*.py
